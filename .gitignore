#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Admin SDK service accounts (server-only; never ship in the client app)
*-adminsdk-*.json

# Firebase CLI local cache
.firebase/

# Local Dart analyzer reports (dart run tool/analyze_lib_report.dart)
tool/analyzer_reports/

# Keys and private settings stay on this Mac.
.env
.env.*
*.pem
*.p12
*.p8
*.jks
*.keystore
android/key.properties

# This Firebase project's app config: each copy of the app gets its own (flutterfire configure).
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart
